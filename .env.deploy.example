# Copie para .env na EC2 (modo deploy / apresentação).
# NÃO coloque GEMINI_API_KEY aqui — só no Vault (secret/ms-ia).

# Lambda AWS (Function URL, sem barra no final)
LAMBDA_BASE_URL=https://lvedwgvp7nb2srqvltwos37y7u0vztzp.lambda-url.us-east-2.on.aws

# IA real + MCP de terceiro
AI_STUB=false
AI_PROVIDER=gemini
MCP_ENABLED=true
MS_IA_PROFILES=docker,vault

VAULT_URI=http://vault:8200
VAULT_TOKEN=root

CHAOS_MONKEY_ENABLED=false
GATEWAY_RATE_PER_SECOND=40
JAVA_TOOL_OPTIONS=-Xmx384m
JAVA_TOOL_OPTIONS_MS_IA=-Xmx512m
