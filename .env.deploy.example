# Copie para .env no host de deploy.
# Credenciais LLM: apenas no Vault (secret/ms-ia), nunca neste arquivo.

# Lambda (Function URL, sem barra no final)
LAMBDA_BASE_URL=https://lvedwgvp7nb2srqvltwos37y7u0vztzp.lambda-url.us-east-2.on.aws

MCP_ENABLED=true
MS_IA_PROFILES=docker,vault

VAULT_URI=http://vault:8200
VAULT_TOKEN=root

CHAOS_MONKEY_ENABLED=false
GATEWAY_RATE_PER_SECOND=40
JAVA_TOOL_OPTIONS=-Xmx384m
JAVA_TOOL_OPTIONS_MS_IA=-Xmx512m

# Config Server remoto (alterações via commit no repositório + /actuator/refresh)
CONFIG_PROFILE=git
CONFIG_GIT_URI=https://github.com/maycon-mdrs/ai-powered-web-application.git
CONFIG_GIT_LABEL=main
CONFIG_GIT_SEARCH_PATHS=config-repo
CONFIG_GIT_FORCE_PULL=true
# Repositório privado:
# SPRING_CLOUD_CONFIG_SERVER_GIT_USERNAME=
# SPRING_CLOUD_CONFIG_SERVER_GIT_PASSWORD=
