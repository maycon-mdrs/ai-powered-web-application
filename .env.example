# Dev local / smoke sem chave LLM. Para EC2 “de verdade” use:
#   cp .env.deploy.example .env
#   ./scripts/docker-up-deploy.sh
#
# Não commitar .env com segredos. GEMINI_API_KEY só no Vault.

# Lambda local (profile local-lambda) — em deploy use a Function URL no .env.deploy.example
LAMBDA_BASE_URL=http://ms-lambda:9000

AI_STUB=true
AI_PROVIDER=gemini
MCP_ENABLED=false
# VAULT_TOKEN=root

CHAOS_MONKEY_ENABLED=false
GATEWAY_RATE_PER_SECOND=40
JAVA_TOOL_OPTIONS=-Xmx384m
JAVA_TOOL_OPTIONS_MS_IA=-Xmx512m
