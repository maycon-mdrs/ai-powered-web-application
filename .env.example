# Copie para .env e ajuste. Não commitar .env com segredos.

# Lambda: Function URL da AWS (sem barra no final) OU http://ms-lambda:9000 com --profile local-lambda
LAMBDA_BASE_URL=http://ms-lambda:9000

# IA
AI_STUB=true
AI_PROVIDER=gemini
MCP_ENABLED=false
# Com --profile vault use: MS_IA_PROFILES=docker,vault e AI_STUB=false
# MS_IA_PROFILES=docker,vault
# VAULT_TOKEN=root

CHAOS_MONKEY_ENABLED=false
GATEWAY_RATE_PER_SECOND=40
JAVA_TOOL_OPTIONS=-Xmx384m
JAVA_TOOL_OPTIONS_MS_IA=-Xmx512m
